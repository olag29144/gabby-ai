# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEYS=gsk_yourkeyhere

# ── Google Gemini direct (keys start with AIza) ───────────────────────────────
GEMINI_API_KEYS=AIzaSyYourKeyHere

# ── Default model ─────────────────────────────────────────────────────────────
DEFAULT_MODEL=groq/qwen/qwen3.8-27b

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_yourkey
SUPABASE_SECRET_KEY=sb_secret_yourkey
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ── Supabase redirect URL (update this when deploying) ───────────────────────
NEXT_PUBLIC_SITE_URL=https://gabby-ai-phi.vercel.app
