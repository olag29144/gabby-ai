# ── OpenRouter (recommended — access to Gemini, Claude, GPT-4, Llama) ────────
# Get keys at: https://openrouter.ai/keys
# Add multiple keys separated by commas for automatic rotation/fallback
OPENROUTER_API_KEYS=sk-or-v1-key1here,sk-or-v1-key2here

# ── Groq (ultra-fast free inference for Llama / Mixtral / Gemma) ─────────────
# Get keys at: https://console.groq.com/keys
GROQ_API_KEYS=gsk_yourkeyhere

# ── Google Gemini direct (optional — keys start with AIza) ───────────────────
# Get keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=AIzaSyYourKeyHere

# ── Default model ─────────────────────────────────────────────────────────────
DEFAULT_MODEL=google/gemini-2.0-flash-exp:free

PORT=3001
SESSION_SECRET=change_this_to_a_long_random_string
